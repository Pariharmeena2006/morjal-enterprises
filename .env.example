# Prisma Postgres. Use a freshly rotated URL; never put real credentials in this file.
MORJAL_DATABASE_URL="postgres://USERNAME:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"
BLOB_READ_WRITE_TOKEN="your-vercel-blob-read-write-token"
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="MORJAL Enterprises <accounts@your-verified-domain.example>"

# Shiprocket
SHIPROCKET_EMAIL="your-shiprocket-email"
SHIPROCKET_PASSWORD="your-shiprocket-password"

# Image Storage (Cloudinary, AWS S3, etc.)
# Add your image storage credentials here

# WhatsApp Business number for order enquiries (digits only, e.g. 919876543210)
# Falls back to WebsiteSettings.whatsappNumber configured in /admin/settings
WHATSAPP_NUMBER="919694142555"

# PhonePe Payment Gateway (server-side only — never expose to client)
# Env vars override /admin/settings values when set.
PHONEPE_MERCHANT_ID=""
PHONEPE_CLIENT_ID=""
PHONEPE_CLIENT_SECRET=""
PHONEPE_CLIENT_VERSION="1"
PHONEPE_ENV="sandbox"
# Optional: shared secret to authenticate PhonePe server webhooks
PHONEPE_WEBHOOK_USERNAME=""
PHONEPE_WEBHOOK_PASSWORD=""
